---
interface Props { title: string; description?: string }
const { title, description = '' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title}｜打印版</title>
    <style>
      :root { color: #0f172a; background: #eef3f9; font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', 'Noto Sans SC', 'Microsoft YaHei', sans-serif; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      .print-actions { position: sticky; z-index: 10; top: 0; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 12px max(20px, calc((100% - 900px) / 2)); color: #334155; border-bottom: 1px solid #cbd5e1; background: rgba(255,255,255,.94); backdrop-filter: blur(12px); }
      .print-actions p { margin: 0; font-size: 13px; }
      .print-actions button { padding: 9px 16px; color: white; border: 0; border-radius: 8px; background: #2563eb; font: inherit; font-weight: 600; cursor: pointer; }
      .sheet { width: min(calc(100% - 28px), 900px); min-height: 1100px; margin: 28px auto; padding: 60px 68px; background: white; box-shadow: 0 12px 40px rgba(15,23,42,.1); }
      .print-brand { color: #2563eb; font-size: 11px; font-weight: 700; letter-spacing: .12em; }
      h1 { margin: 12px 0 8px; font-size: 30px; line-height: 1.25; }
      .subtitle { margin: 0 0 32px; color: #64748b; font-size: 13px; }
      .print-content { font-size: 13px; line-height: 1.75; }
      .print-content h2 { margin: 28px 0 12px; padding-top: 8px; border-top: 1px solid #dbe3ef; font-size: 18px; }
      .print-content p { margin: 8px 0; }
      .print-content .bilingual-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 14px 0; padding: 14px; border: 1px solid #dbe3ef; border-radius: 8px; break-inside: avoid; }
      .print-content .lang-zh { color: #475569; }
      .print-content .segment-initials { display: none; }
      .print-content img { max-width: 100%; max-height: 620px; margin: 16px auto; object-fit: contain; break-inside: avoid; }
      .print-content table { width: 100%; border-collapse: collapse; break-inside: avoid; }
      .print-content td, .print-content th { padding: 7px; border: 1px solid #cbd5e1; }
      .print-source { margin-top: 36px; padding-top: 14px; color: #64748b; border-top: 1px solid #dbe3ef; font-size: 10px; }
      @page { size: A4 portrait; margin: 14mm; }
      @media print {
        :root { background: white; }
        .print-actions { display: none; }
        .sheet { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
        .print-content { font-size: 10.5pt; }
      }
      @media (max-width: 640px) {
        .sheet { padding: 34px 22px; }
        .print-content .bilingual-pair { grid-template-columns: 1fr; gap: 4px; }
        .print-actions { align-items: flex-start; flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <div class="print-actions">
      <p>在打印面板中选择“另存为 PDF”；移动端可通过系统分享菜单保存。</p>
      <button type="button" onclick="window.print()">打印或另存为 PDF</button>
    </div>
    <main class="sheet"><slot /></main>
  </body>
</html>
