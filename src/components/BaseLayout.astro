---
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  contentId?: string;
}

const {
  title = '考研英语作文大观',
  description = '考研英语大作文、小作文、模板与语料的阅读背诵网站。',
  contentId,
} = Astro.props;
const fullTitle = title === '考研英语作文大观' ? title : `${title}｜考研英语作文大观`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2563eb" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <script is:inline>
      (() => {
        try {
          const saved = JSON.parse(localStorage.getItem('kaoyan-writing:v1') || '{}');
          if (saved.theme === 'dark') document.documentElement.dataset.theme = 'dark';
        } catch {}
      })();
    </script>
  </head>
  <body data-content-id={contentId}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
