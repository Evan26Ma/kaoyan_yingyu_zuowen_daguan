---
interface Props { id: string }
const { id } = Astro.props;
---

<aside class="study-toolbar" aria-label="背诵工具">
  <div class="toolbar-inner shell">
    <div class="reveal-control" role="group" aria-label="内容显示方式">
      <span class="toolbar-label">背诵模式</span>
      <button type="button" data-reveal-mode="all" aria-pressed="true">中英对照</button>
      <button type="button" data-reveal-mode="hide-en" aria-pressed="false">遮住英文</button>
      <button type="button" data-reveal-mode="hide-zh" aria-pressed="false">遮住中文</button>
    </div>
    <div class="learning-actions">
      <button type="button" data-action="favorite" data-id={id} aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 17.3-6.2 3.3 1.2-7-5-4.9 7-1L12 1.4l3.1 6.3 6.9 1-5 4.9 1.2 7Z"></path></svg>
        <span>收藏</span>
      </button>
      <button type="button" data-action="complete" data-id={id} aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
        <span>标为已学</span>
      </button>
    </div>
  </div>
</aside>
