---
import PrintLayout from '../../../components/PrintLayout.astro';
const html = `<div class="bilingual-pair"><p class="lang-en">As is vividly depicted in the drawing, two students are approaching the same goal in different ways.</p><p class="lang-zh">正如图画中生动描绘的那样，两名学生正以不同方式奔向同一个目标。</p></div><div class="bilingual-pair"><p class="lang-en">The picture reminds us that persistence is often more important than speed.</p><p class="lang-zh">这幅图提醒我们，坚持往往比速度更重要。</p></div>`;
---
<PrintLayout title="示例：图画作文开头段" description="使用向导演示卡片">
  <div class="print-brand">考研英语作文大观 · 背诵卡</div>
  <h1>示例：图画作文开头段</h1>
  <p class="subtitle">使用向导固定示例 · 完整中英双语版</p>
  <div class="print-content" set:html={html}></div>
  <p class="print-source">本页仅用于演示下载与打印功能。</p>
</PrintLayout>
