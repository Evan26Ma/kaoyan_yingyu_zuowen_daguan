---
import BaseLayout from '../../components/BaseLayout.astro';
import StudyToolbar from '../../components/StudyToolbar.astro';
import { catalog, loadEntry } from '../../lib/catalog.mjs';

const item = await loadEntry(catalog.find((entry) => entry.id === 'seven-five'));
---

<BaseLayout title={item.title} description={item.description} contentId={item.id}>
  <div class="shell breadcrumb"><a href="/">首页</a><span>/</span><span>附加资料</span></div>
  <header class="article-hero">
    <div class="shell">
      <p class="eyebrow">EXTRA MATERIAL</p>
      <h1>{item.title}</h1>
      <p class="lead">{item.description} 这一部分作为作文学习之外的补充。</p>
      <div class="article-meta">{item.tags.map((tag: string) => <span>#{tag}</span>)}</div>
    </div>
  </header>
  <StudyToolbar id={item.id} />
  <div class="shell article-layout">
    <article class="study-content" data-study-content set:html={item.html}></article>
    <aside class="article-toc"><strong>本文目录</strong><ol>{item.headings.map((heading: any) => <li><a href={`#${heading.id}`}>{heading.title}</a></li>)}</ol></aside>
  </div>
</BaseLayout>
