---
import BaseLayout from '../components/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { catalog } from '../lib/catalog.mjs';

const entries = catalog.filter((item) => item.category !== 'extra');
---

<BaseLayout title="我的收藏" description="保存在当前浏览器中的作文收藏与学习进度。">
  <section class="library-hero">
    <div class="shell section-heading">
      <p class="eyebrow">MY COLLECTION</p>
      <h1>我的收藏</h1>
      <p>收藏只保存在当前浏览器，不需要注册，也不会上传你的学习记录。</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="shell">
      <div class="resource-grid" data-favorites-grid>
        {entries.map((item) => <ResourceCard item={item} hidden context="favorite" />)}
      </div>
      <div class="empty-state" data-favorites-empty>
        <strong>还没有收藏内容</strong><br />在资料卡片或学习页面点击“收藏”，它就会出现在这里。
      </div>
    </div>
  </section>
</BaseLayout>
