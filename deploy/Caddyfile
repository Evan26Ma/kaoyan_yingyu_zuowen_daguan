zuowen.kaoyangogogo.fun {
    root * /var/www/zuowen.kaoyangogogo.fun/current
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'"
        -Server
    }

    @immutable path_regexp immutable \.(?:css|js|jpg|jpeg|png|svg|webp|woff2)$
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    header /search-index.json Cache-Control "public, max-age=300"

    file_server
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
